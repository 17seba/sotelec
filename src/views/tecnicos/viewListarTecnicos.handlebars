<table class="table">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Nombre</th>
      <th scope="col">Apellido 1</th>
      <th scope="col">Apellido2</th>
      <th scope="col">Email</th>
    </tr>
  </thead>
  <tbody>
    {{#each tecnicos}}
    <tr>
      <th scope="row">{{this.usuario_id}}</th>
      <td>{{this.nombre}}</td>
      <td>{{this.Apellido1}}</td>
      <td>{{this.Apellido2}}</td>
      <td>{{this.Email}}</td>
    </tr>
  {{/each}}
  </tbody>
</table>